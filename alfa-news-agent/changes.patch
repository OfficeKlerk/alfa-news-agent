+def test_shutdown_stops_all_processes_and_waits_for_exit():
+    rows = [Mock(), Mock(), Mock()]
+    for row in rows:
+        row.poll.return_value = None
+    live.stop_services(rows)
+    for row in rows:
+        row.terminate.assert_called_once()
+        row.wait.assert_called_once_with(timeout=10)
