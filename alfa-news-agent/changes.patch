+    && !/(?:банк\s+россии|цб|совет\s+директоров\s+банка\s+россии).{0,80}(?:сохрани|повыс|сниз|решен).{0,40}ключев[а-я]*\s+ставк/iu.test(body.slice(0, 400)))
