++              "NEWS_ENABLED": "0", "NEWS_POLL_SECONDS": str(poll), "NEWS_FULL_TEXT_ENABLED": "1",
++              "LIVE_PIPELINE_ENABLED": "0", "RANK_MODE": "news-analysis",
