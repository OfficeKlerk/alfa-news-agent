++                     and len(set(companies)) == len(companies))
++        except (ValueError, TypeError):
++            valid = False
++        if not valid:
++            raise ValueError("LIVE_COMPANY_IDS_JSON must contain distinct company IDs within LIVE_MAX_COMPANIES")
++    supervisor = {
