++         {"SERVICE_KIND": "agent", "LLM_API_KEY": env.get("LLM_API_KEY", "") if args.with_llm else ""}),
++        ("gateway", ["node", "dist/integration/index.js"], {"LIVE_PIPELINE_ENABLED": "1"}),
