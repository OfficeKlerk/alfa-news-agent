LLM_MODE=demo
LLM_API_KEY=
LLM_BASE_URL=https://changellenge.up.railway.app/v1
# Alternative: https://api.alfahack-gateway26.ru/v1
LLM_MODEL=qwen/qwen3.6-35b-a3b
# Role 2: use json_schema only if the selected provider/model supports strict Structured Outputs.
LLM_RESPONSE_FORMAT=json_object
LLM_TIMEOUT_SECONDS=120
# Local request-count limit, NOT a monetary budget.
MAX_DAILY_LLM_CALLS=100
LLM_MAX_CONTEXT_BYTES=200000
LLM_MAX_RESPONSE_BYTES=1000000
# Explicit allowlist for another OpenAI-compatible provider, if needed:
# LLM_ALLOWED_MODELS_JSON=["your-model-id"]
# Optional trusted RSS feeds; redirecting feeds are not supported.
NEWS_FEEDS_JSON=[]
HOST=127.0.0.1
PORT=8000
# Final JSON token limit. Planning has a separate limit below.
LLM_MAX_OUTPUT_TOKENS=6000
# Cap for grounded analysis/question JSON (default 2500, never above LLM_MAX_OUTPUT_TOKENS).
# REPORT8: accepted answers used <=1767 output tokens; loops ran to 6000 (~0.8 cost each).
# A truncated answer is still rejected without repair; this only stops a loop earlier.
# LLM_GENERATION_MAX_TOKENS=2500
# Tool-planning token limit; reasoning may consume part of it.
LLM_MAX_PLANNING_TOKENS=6000
# Reasoning budget. Reasoning models spend max_tokens on hidden reasoning BEFORE any
# JSON, so a 6000 limit can truncate with no answer. Bound it (none|minimal|low|medium|high)
# so the output budget reaches the JSON. Empty = let the model decide.
# Measured on the changellenge gateway (qwen3.6-35b-a3b): "none" removes the truncation
# and returns a full JSON in ~14s; default/low are slower and can still truncate.
# See docs/reports/MODEL_SETTINGS.md.
LLM_REASONING_EFFORT=none
# Escape hatch for provider-specific body fields, merged shallowly into the request.
# Cannot override model/messages/stream/response_format/max_tokens/max_completion_tokens. Examples by gateway:
#   vLLM/Qwen: {"chat_template_kwargs":{"enable_thinking":false}}
#   OpenRouter-style: {"reasoning":{"max_tokens":1024}}
# LLM_EXTRA_BODY_JSON={"chat_template_kwargs":{"enable_thinking":false}}
# Same, but sent only with LLM_RESPONSE_FORMAT=json_schema (strict). Use it to pin the provider route
# once the gateway owner confirms the field; REPORT8 strict calls routed to AkashML came back empty.
# Unconfirmed, OpenRouter-style example (do not enable before confirmation):
# LLM_STRICT_EXTRA_BODY_JSON={"provider":{"order":["DeepInfra","DekaLLM"],"allow_fallbacks":false,"require_parameters":true}}
# Provider-only maxLength for claim text/quote in strict mode (>=900; the longest saved verbatim quote is 846).
# Off by default until a provider confirms maxLength support. Local validators are unchanged.
# LLM_STRICT_MAX_CLAIM_STRING=1000
# Sweep settings to find a working combination (per docs/reports/MODEL_SETTINGS.md):
#   node --import tsx scripts/tune_model.ts --max-output 6000,12000,16000 --reasoning none,low

# Integration gateway. Legacy npm start is explicit offline-development only.
# ML_URL=http://127.0.0.1:8101
RETRIEVAL_MODE=http
# RETRIEVAL_URL=http://127.0.0.1:8102
AGENT_MODE=http
# AGENT_URL=http://127.0.0.1:8102
# Python reads process environment; it does not automatically load this file.
# URLs are commented so Docker can use internal DNS defaults from compose.yaml.
# To enable JSON request logs in a direct gateway process:
INTEGRATION_LOG=0

# Authentication: default is fail-closed OIDC. scripts/dev.py explicitly selects
# development for offline fixtures. Do not expose development to the Internet.
AUTH_MODE=oidc
PUBLIC_BASE_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
# Trusted IdP-issued flat arrays; users must not be able to edit their own grants.
OIDC_COMPANY_CLAIM=company_ids
OIDC_ROLE_CLAIM=roles
OIDC_SCOPES=openid profile
# Generate each independently: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_COOKIE_KEY=
INTERNAL_API_TOKEN=
# Production setup, TLS and grant mapping: docs/integration/PRODUCTION_ACCESS.md
# Real company_context SQLite file for compose.production.yaml (absolute host path).
CONTEXT_DB_HOST=
