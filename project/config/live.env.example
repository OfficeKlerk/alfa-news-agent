# Copy to private .env.live. This example contains no credentials.
# Local runner reads config/news-sources.json if NEWS_FEEDS_JSON is omitted.
# Compose requires the explicit source list below; adapters are selected by registry.
NEWS_FEEDS_JSON='["https://www.cbr.ru/rss/RssPress","https://www.cbr.ru/rss/eventrss","https://www.nalog.gov.ru/rn77/news/","https://mintrans.gov.ru/press-center/news","https://tass.ru/rss/v2.xml","https://www.interfax.ru/rss","https://www.kommersant.ru/rss/news.xml","https://rss.garant.ru/news/","https://www.pnp.ru/rss/index.xml","https://1prime.ru/export/rss2/index.xml","https://lenta.ru/rss/news/economics/","https://www.finam.ru/analysis/conews/rsspoint/","https://www.agroinvestor.ru/feed/public-agronews.xml"]'
NEWS_POLL_SECONDS=300
NEWS_SOURCE_CONCURRENCY=3
NEWS_FULL_TEXT_ENABLED=1
NEWS_FULL_TEXT_CONCURRENCY=3
NEWS_FULL_TEXT_REFRESH_SECONDS=3600
NEWS_FULL_TEXT_MAX_PER_SOURCE=20
NEWS_SEED_MODE=none
NEWS_ENABLED=1

# Persistent discovery and workers run inside the gateway process.
LIVE_PIPELINE_ENABLED=1
LIVE_SCAN_SECONDS=60
LIVE_LOOKBACK_DAYS=7
LIVE_MAX_CANDIDATES=500
LIVE_COMPANY_NEWS_LIMIT=5
LIVE_MAX_COMPANIES=100
LIVE_WORKER_CONCURRENCY=1
# Optional initial subscriptions. Otherwise select companies in /live/.
LIVE_COMPANY_IDS_JSON='[]'
LIVE_RESTART_BASE_SECONDS=1
LIVE_RESTART_MAX_SECONDS=60
LIVE_RESTART_STABLE_SECONDS=60
LIVE_STARTUP_TIMEOUT_SECONDS=60
LIVE_SHUTDOWN_GRACE_SECONDS=30

# Local paid generation requires --with-llm as well as a private key.
# Docker paid generation requires ANALYSIS_ENABLED=1 as well as a private key.
ANALYSIS_ENABLED=0
LLM_MODE=live
LLM_API_KEY=
LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_MODEL=qwen/qwen3.6-35b-a3b
LLM_RESPONSE_FORMAT=json_object
MAX_DAILY_LLM_CALLS=100
MAX_DAILY_LLM_TOKENS=2000000
MAX_COMPANY_DAILY_LLM_CALLS=20
LLM_QUESTION_RESERVE_CALLS=10
LLM_QUESTION_RESERVE_TOKENS=200000

# Local ports. All four must differ and be available.
PORT=8000
ML_PORT=8101
RETRIEVAL_PORT=8102
AGENT_PORT=8202

# Compose only: absolute path to the existing company_context database.
# Local runner instead uses --context-db.
CONTEXT_DB_HOST_PATH=
GATEWAY_PORT=8000

# Required for authenticated live startup; see deploy/MERGED_RELEASE.md
AUTH_MODE=oidc
PUBLIC_BASE_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
AUTH_COOKIE_KEY=
INTERNAL_API_TOKEN=
