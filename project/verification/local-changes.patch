+      LLM_GENERATION_MAX_TOKENS: ${LLM_GENERATION_MAX_TOKENS:-2500}
+      MAX_DAILY_LLM_CALLS: ${MAX_DAILY_LLM_CALLS:-100}
+      MAX_DAILY_LLM_TOKENS: ${MAX_DAILY_LLM_TOKENS:-2000000}
+      MAX_COMPANY_DAILY_LLM_CALLS: ${MAX_COMPANY_DAILY_LLM_CALLS:-20}
+      LLM_QUESTION_RESERVE_CALLS: ${LLM_QUESTION_RESERVE_CALLS:-10}
