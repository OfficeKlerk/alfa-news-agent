+      LLM_MAX_CONTEXT_BYTES: ${LLM_MAX_CONTEXT_BYTES:-200000}
+      LLM_MAX_RESPONSE_BYTES: ${LLM_MAX_RESPONSE_BYTES:-1000000}
+      NEWS_SEED_MODE: none
