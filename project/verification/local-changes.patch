+      LLM_REASONING_EFFORT: ${LLM_REASONING_EFFORT:-}
+      LLM_EXTRA_BODY_JSON: ${LLM_EXTRA_BODY_JSON:-}
+      LLM_STRICT_EXTRA_BODY_JSON: ${LLM_STRICT_EXTRA_BODY_JSON:-}
