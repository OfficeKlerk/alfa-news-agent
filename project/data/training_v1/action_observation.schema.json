{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observed business decision episode; no counterfactual labels",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "company_id", "event_ids", "decision_at", "snapshot", "currency", "available_actions", "chosen_actions", "assignment", "outcome"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "decision_at": {"type": "string", "format": "date-time"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_at", "source", "sha256", "pre_decision_data_ref", "missing_fields"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "source": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pre_decision_data_ref": {"type": "string", "minLength": 1},
        "missing_fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "available_actions": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "dose_unit", "max_dose", "availability_source"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "dose_unit": {"type": "string", "minLength": 1},
        "max_dose": {"type": "number", "minimum": 0},
        "availability_source": {"type": "string", "minLength": 1}
      }
    }},
    "chosen_actions": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "dose", "dose_unit", "implemented_at", "cost", "liquidity_required", "source"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "dose": {"type": "number", "exclusiveMinimum": 0},
        "dose_unit": {"type": "string", "minLength": 1},
        "implemented_at": {"type": "string", "format": "date-time"},
        "cost": {"type": ["number", "null"], "minimum": 0},
        "liquidity_required": {"type": ["number", "null"], "minimum": 0},
        "source": {"type": "string", "minLength": 1}
      }
    }},
    "assignment": {
      "type": "object", "additionalProperties": false,
      "required": ["mechanism", "reason", "policy_version", "propensity"],
      "properties": {
        "mechanism": {"enum": ["business_choice", "randomized", "rule", "model", "unknown"]},
        "reason": {"type": "string", "minLength": 1},
        "policy_version": {"type": ["string", "null"]},
        "propensity": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "outcome": {"oneOf": [{"type": "null"}, {
      "type": "object", "additionalProperties": false,
      "required": ["period_start", "period_end", "metric", "value", "unit", "measurement_rule", "includes_action_costs", "source", "concurrent_changes"],
      "properties": {
        "period_start": {"type": "string", "format": "date-time"},
        "period_end": {"type": "string", "format": "date-time"},
        "metric": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "measurement_rule": {"type": "string", "minLength": 1},
        "includes_action_costs": {"type": "boolean"},
        "source": {"type": "string", "minLength": 1},
        "concurrent_changes": {"type": "array", "items": {"type": "string"}}
      }
    }]}
  }
}
