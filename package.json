{
  "name": "alfa-insight",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test server/tests/*.test.ts server/integration/tests/*.test.ts",
    "test:legacy": "node --import tsx --test server/tests/*.test.ts",
    "integration:start": "node dist/integration/index.js",
    "integration:mocks": "node dist/integration/mock-server.js",
    "integration:dev": "npm run build && python scripts/dev.py",
    "integration:smoke": "npm run build && python scripts/dev.py --smoke",
    "llm:evaluate": "node --import tsx scripts/evaluate_llm.ts",
    "llm:tune": "node --import tsx scripts/tune_model.ts"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "csv-parse": "7.0.3",
    "express": "5.3.0",
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.0.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
