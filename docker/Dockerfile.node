FROM node:24.13.0-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY server/ server/
RUN npm run build && npm prune --omit=dev

FROM node:24.13.0-bookworm-slim
WORKDIR /app
COPY --from=build /app/node_modules node_modules/
COPY --from=build /app/dist dist/
COPY package.json ./
COPY frontend/ frontend/
COPY integration/frontend/ integration/frontend/
COPY integration/analysis_ui/ integration/analysis_ui/
COPY integration/learning_ui/ integration/learning_ui/
COPY integration/fixtures/ integration/fixtures/
COPY contracts/ contracts/
COPY data/*.gz data/research.json data/demo_news.json data/reviewed_news.json data/
RUN mkdir -p var && chown node:node var
USER node
ENV HOST=0.0.0.0 PORT=8000 LLM_MODE=demo
EXPOSE 8000
CMD ["node", "dist/integration/index.js"]
